# 環境変数テンプレート
# このファイルをコピーして .env を作成してください
# cp .env.example .env

# MkDocs サーバー設定
MKDOCS_PORT=8000

# ユーザーマニュアル（gulp manual:build）設定
# MANUAL_TITLE=ユーザーマニュアル
# MANUAL_COPYRIGHT=組織名
# MANUAL_PORTAL_URL=../index.html
# PLANTUML_SERVER_URL=http://www.plantuml.com/plantuml

# Docker 設定（通常は設定不要、Docker Desktop が自動設定）
# DOCKER_HOST=npipe:////./pipe/docker_engine

# SSH 接続設定
DEV_SSH_HOST=xxxxxxxx
DEV_SSH_USER=xxxxxxxx
STG_SSH_HOST=xxxxxxxx
STG_SSH_USER=xxxxxxxx
PRD_SSH_HOST=xxxxxxxx
PRD_SSH_USER=xxxxxxxx

# OKF（gulp okf:*）設定
# OKF_BUNDLE=docs
# OKF_TOOL_DIR=tmp/open-knowledge-format
# OKF_VIZ_OUT=tmp/okf/viz.html
# okf:enrich 用（要 gcloud ADC）
# OKF_DATASET=my-project.my_dataset
# OKF_SEED_FILE=tmp/okf/seeds.txt
# GEMINI_API_KEY=xxxxxxxx
