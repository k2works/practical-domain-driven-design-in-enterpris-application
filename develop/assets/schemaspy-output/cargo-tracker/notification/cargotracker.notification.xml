<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<database name="cargotracker" schema="notification" type="PostgreSQL - 18.6 (Debian 18.6-1.pgdg13+2)">
   <tables>
      <table name="notification" remarks="通知" schema="notification" type="TABLE">
