         <column autoUpdated="false" defaultValue="null" digits="0" id="2" name="recipient_user_id" nullable="false" remarks="宛先の利用者 ID（アクセス・監査の利用者。外部キーを張らない）" size="2147483647" type="uuid" typeCode="1111"/>
