         <checkConstraint constraint="((kind)::text = ANY ((ARRAY['QUOTATION_PRESENTED'::character varying, 'ROUTE_APPROVED'::character varying, 'QUOTATION_EXPIRING'::character varying, 'BOOKING_CONFIRMED'::character varying, 'TRACKING_UNDER_REVIEW'::character varying, 'CONSIGNEE_INVITATION'::character varying, 'PASSWORD_RESET'::character varying, 'USER_INVITATION'::character varying])::text[]))" name="ck_notification_kind"/>
         <checkConstraint constraint="(((status)::text = 'SENT'::text) = (sent_at IS NOT NULL))" name="ck_notification_sent_at"/>
         <checkConstraint constraint="((status)::text = ANY ((ARRAY['PENDING'::character varying, 'SENT'::character varying, 'FAILED'::character varying])::text[]))" name="ck_notification_status"/>
