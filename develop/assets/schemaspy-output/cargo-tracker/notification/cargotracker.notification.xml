         <column autoUpdated="false" defaultValue="null" digits="0" id="5" name="target_ref" nullable="false" remarks="対象の参照（再設定と利用者の招待はトークンの ID。本文は再現しない）" size="200" type="varchar" typeCode="12"/>
         <column autoUpdated="false" defaultValue="null" digits="0" id="6" name="locale" nullable="false" remarks="文面の言語" size="10" type="varchar" typeCode="12"/>
