<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.cargotracker.identity.infrastructure.persistence.IdentityMapper">

    <resultMap id="companyRow" type="com.example.cargotracker.identity.infrastructure.persistence.CompanyRow">
        <constructor>
            <idArg column="id" name="id" javaType="java.util.UUID"/>
            <arg column="name" name="name" javaType="String"/>
            <arg column="kind" name="kind" javaType="String"/>
            <arg column="active" name="active" javaType="_boolean"/>
        </constructor>
    </resultMap>

    <resultMap id="userRow" type="com.example.cargotracker.identity.infrastructure.persistence.UserRow">
        <constructor>
            <idArg column="id" name="id" javaType="java.util.UUID"/>
            <arg column="company_id" name="companyId" javaType="java.util.UUID"/>
            <arg column="email" name="email" javaType="String"/>
            <arg column="display_name" name="displayName" javaType="String"/>
            <arg column="password_hash" name="passwordHash" javaType="String"/>
            <arg column="status" name="status" javaType="String"/>
        </constructor>
    </resultMap>

    <resultMap id="auditRecordRow" type="com.example.cargotracker.identity.infrastructure.persistence.AuditRecordRow">
        <constructor>
            <idArg column="id" name="id" javaType="java.util.UUID"/>
            <arg column="occurred_at" name="occurredAt" javaType="java.time.OffsetDateTime"/>
            <arg column="actor_user_id" name="actorUserId" javaType="java.util.UUID"/>
            <arg column="actor_company_id" name="actorCompanyId" javaType="java.util.UUID"/>
            <arg column="action" name="action" javaType="String"/>
            <arg column="result" name="result" javaType="String"/>
            <arg column="reason" name="reason" javaType="String"/>
        </constructor>
    </resultMap>

    <insert id="insertCompany">
        INSERT INTO identity.company (id, name, kind, active, version, created_at, updated_at)
        VALUES (#{row.id}, #{row.name}, #{row.kind}, #{row.active}, 0, #{now}, #{now})
    </insert>

    <select id="selectCompany" resultMap="companyRow">
        SELECT id, name, kind, active FROM identity.company WHERE id = #{id}
    </select>

    <sql id="userColumns">id, company_id, email, display_name, password_hash, status</sql>

    <insert id="insertUser">
        INSERT INTO identity.app_user
            (id, company_id, email, display_name, password_hash, status, version, created_at, updated_at)
        VALUES (#{row.id}, #{row.companyId}, #{row.email}, #{row.displayName}, #{row.passwordHash}, #{row.status},
                0, #{now}, #{now})
    </insert>

    <insert id="insertUserRole">
        INSERT INTO identity.user_role (user_id, role, granted_at) VALUES (#{userId}, #{role}, #{now})
    </insert>

    <select id="selectUserByEmail" resultMap="userRow">
        SELECT <include refid="userColumns"/> FROM identity.app_user WHERE email = #{email}
    </select>

    <select id="selectUserById" resultMap="userRow">
        SELECT <include refid="userColumns"/> FROM identity.app_user WHERE id = #{id}
    </select>

    <select id="selectUserRoles" resultType="String">
        SELECT role FROM identity.user_role WHERE user_id = #{userId} ORDER BY role
    </select>

    <insert id="insertAuditRecord">
        INSERT INTO identity.audit_record (id, occurred_at, actor_user_id, actor_company_id, action, result, reason)
        VALUES (#{id}, #{occurredAt}, #{actorUserId}, #{actorCompanyId}, #{action}, #{result}, #{reason})
    </insert>

    <select id="selectAuditRecordsByActor" resultMap="auditRecordRow">
        SELECT id, occurred_at, actor_user_id, actor_company_id, action, result, reason
          FROM identity.audit_record
         WHERE actor_user_id = #{actorUserId}
         ORDER BY occurred_at, id
    </select>
</mapper>
