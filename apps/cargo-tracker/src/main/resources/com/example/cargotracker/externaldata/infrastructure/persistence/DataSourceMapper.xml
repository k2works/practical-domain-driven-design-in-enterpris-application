<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!-- 情報源（Bolt 39b）。読み取りだけ（情報源の選定・承認は W10 の運用タスク）。H2 と PostgreSQL の共通の構文で書く（ADR-007）。 -->
<mapper namespace="com.example.cargotracker.externaldata.infrastructure.persistence.DataSourceMapper">

    <resultMap id="dataSourceRow" type="com.example.cargotracker.externaldata.infrastructure.persistence.DataSourceRow">
        <constructor>
            <idArg column="id" name="id" javaType="java.util.UUID"/>
            <arg column="provider" name="provider" javaType="String"/>
            <arg column="record_type" name="recordType" javaType="String"/>
            <arg column="approval_status" name="approvalStatus" javaType="String"/>
        </constructor>
    </resultMap>

    <select id="selectById" resultMap="dataSourceRow">
        SELECT id, provider, record_type, approval_status FROM external_data.data_source WHERE id = #{id}
    </select>

    <!-- ED-INV-01。候補（CANDIDATE）と停止中（SUSPENDED）は数えない -->
    <select id="countApproved" resultType="int">
        SELECT COUNT(*) FROM external_data.data_source WHERE approval_status = 'APPROVED'
    </select>
</mapper>
