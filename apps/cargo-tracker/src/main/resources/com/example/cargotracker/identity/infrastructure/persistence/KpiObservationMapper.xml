<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.cargotracker.identity.infrastructure.persistence.KpiObservationMapper">

    <resultMap id="kpiObservationRow" type="com.example.cargotracker.identity.infrastructure.persistence.KpiObservationRow">
        <constructor>
            <idArg column="transport_request_id" name="transportRequestId" javaType="java.util.UUID"/>
            <arg column="transport_request_number" name="transportRequestNumber" javaType="String"/>
            <arg column="shipper_company_id" name="shipperCompanyId" javaType="java.util.UUID"/>
            <arg column="submitted_at" name="submittedAt" javaType="java.time.OffsetDateTime"/>
            <arg column="first_presented_at" name="firstPresentedAt" javaType="java.time.OffsetDateTime"/>
        </constructor>
    </resultMap>

    <sql id="columns">transport_request_id, transport_request_number, shipper_company_id, submitted_at, first_presented_at</sql>

    <!-- 同じ輸送要求の記録が既にあれば何もしない（受信側の冪等性）。
         一意制約違反を捕まえて続けるのではなく、INSERT の条件で吸収する（ADR-007）。
         ON CONFLICT は H2 で使えないため、両方で動く INSERT ... SELECT ... WHERE NOT EXISTS にする。 -->
    <insert id="insertIfAbsent">
        INSERT INTO identity.kpi_observation (<include refid="columns"/>)
        SELECT #{transportRequestId}, #{transportRequestNumber}, #{shipperCompanyId}, #{submittedAt}, #{firstPresentedAt}
         WHERE NOT EXISTS (
               SELECT 1 FROM identity.kpi_observation WHERE transport_request_id = #{transportRequestId})
    </insert>

    <!-- 最初の提示時刻は、まだないか、渡した時刻のほうが早いときだけ書く（KPI-INV-01）。
         読んでから書くまでの間にほかの DE-03 が書いても、条件で早い時刻が残る（再配信と届く順の入れ替わり）。 -->
    <update id="updateFirstPresentedAtIfEarlier">
        UPDATE identity.kpi_observation
           SET first_presented_at = #{firstPresentedAt}
         WHERE transport_request_id = #{transportRequestId}
           AND (first_presented_at IS NULL OR first_presented_at &gt; #{firstPresentedAt})
    </update>

    <select id="selectByTransportRequestId" resultMap="kpiObservationRow">
        SELECT <include refid="columns"/> FROM identity.kpi_observation WHERE transport_request_id = #{transportRequestId}
    </select>

    <select id="selectAll" resultMap="kpiObservationRow">
        SELECT <include refid="columns"/> FROM identity.kpi_observation ORDER BY submitted_at DESC
    </select>
</mapper>
