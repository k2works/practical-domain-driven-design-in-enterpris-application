<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.cargotracker.routing.infrastructure.persistence.RoutingCaseNumberCounterMapper">

    <!-- H2 と PostgreSQL の共通の構文で書く（ADR-007）。業務番号の採番（見積り）と同じ形 -->

    <insert id="insertYear">
        INSERT INTO routing.routing_case_number_counter (number_year, last_no) VALUES (#{year}, 0)
    </insert>

    <!-- UPDATE が行ロックを取り、案件の作成のトランザクションの終わりまで同じ年の採番を直列にする -->
    <update id="increment">
        UPDATE routing.routing_case_number_counter SET last_no = last_no + 1 WHERE number_year = #{year}
    </update>

    <select id="selectLastNo" resultType="int">
        SELECT last_no FROM routing.routing_case_number_counter WHERE number_year = #{year}
    </select>
</mapper>
