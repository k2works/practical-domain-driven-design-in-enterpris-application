<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.cargotracker.tracking.infrastructure.persistence.ServiceCaseNumberCounterMapper">

    <!-- H2 と PostgreSQL の共通の構文で書く（ADR-007）。案件番号の採番（経路設計）と同じ形。Bolt 40-6 -->

    <insert id="insertYear">
        INSERT INTO tracking.service_case_number_counter (number_year, last_no) VALUES (#{year}, 0)
    </insert>

    <!-- UPDATE が行ロックを取り、起票のトランザクションの終わりまで同じ年の採番を直列にする -->
    <update id="increment">
        UPDATE tracking.service_case_number_counter SET last_no = last_no + 1 WHERE number_year = #{year}
    </update>

    <select id="selectLastNo" resultType="int">
        SELECT last_no FROM tracking.service_case_number_counter WHERE number_year = #{year}
    </select>
</mapper>
