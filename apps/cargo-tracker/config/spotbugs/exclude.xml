<?xml version="1.0" encoding="UTF-8"?>
<!--
  SpotBugs で抑止する指摘と、その理由。抑止は最小にし、理由のないものは足さない。
-->
<FindBugsFilter>
    <!--
      EI_EXPOSE_REP2: DI で受け取った部品（MyBatis のマッパーなど）を保持することへの指摘。
      部品は Spring が管理するシングルトンで、値として外へ渡すものではないため、送信アダプター（infrastructure）に限って抑止する。
    -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP2"/>
        <Package name="~com\.example\.cargotracker\..*\.infrastructure\..*"/>
    </Match>
    <!--
      EI_EXPOSE_REP2: identity のアプリケーションのサービス（commandservices・queryservices・eventhandlers・outboundservices の ACL）が
      DI で受け取ったリポジトリなどの部品を保持することへの指摘。上と同じく Spring が管理するシングルトンで、値として外へ渡さない。
      Bolt 31 から 34d まではクラスを 1 つずつ足して抑止していたが、identity の application.internal はどれも DI の部品を保持するだけの
      サービスの集まりなので、パッケージで指定する（Bolt 34c の開始準備の決定 3、2026-10-17、human:kakimomokuri）。
    -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP2"/>
        <Package name="~com\.example\.cargotracker\.identity\.application\.internal\..*"/>
    </Match>
    <!--
      EI_EXPOSE_REP2: application.internal の外で、同じく DI の部品を保持するだけと分かっているクラス。このクラスに限って抑止する。
    -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP2"/>
        <Or>
            <!-- A-08 の画面は、DI の部品（再登録のサービス）を保持するだけ（Bolt 33b） -->
            <Class name="com.example.cargotracker.identity.interfaces.web.TotpReEnrollmentController"/>
            <!-- 通知のメールの送信のサービスも、同じく DI の部品を保持するだけ（Bolt 33） -->
            <Class name="com.example.cargotracker.notification.application.internal.commandservices.PasswordResetMailService"/>
        </Or>
    </Match>
    <!--
      SE_TRANSIENT_FIELD_NOT_RESTORED: 認証の結果のトークンの 2 つ目の要素の経路（Bolt 33e）は、意図して transient にしている。
      session（Spring Session JDBC）に経路を保存せず、直列化の形を変えないことで、ローリング配備の間に古い版が新しい版の session を
      読めるようにする（2026-10-16、Bolt 33e の開始準備の決定 4、human:kakimomokuri）。経路を読むのは同じ request の中の成功の扱い
      だけで、session から読み直したトークンの経路は null でよい。このクラスのこの欄に限って抑止する。
    -->
    <Match>
        <Bug pattern="SE_TRANSIENT_FIELD_NOT_RESTORED"/>
        <Class name="com.example.cargotracker.identity.infrastructure.security.TotpAuthenticationToken"/>
        <Field name="path"/>
    </Match>
</FindBugsFilter>
