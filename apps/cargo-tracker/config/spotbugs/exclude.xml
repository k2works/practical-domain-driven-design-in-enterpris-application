<?xml version="1.0" encoding="UTF-8"?>
<!--
  SpotBugs で抑止する指摘と、その理由。抑止は最小にし、理由のないものは足さない。
-->
<FindBugsFilter>
    <!--
      EI_EXPOSE_REP2: DI で受け取った部品（MyBatis のマッパーなど）を保持することへの指摘。
      部品は Spring が管理するシングルトンで、値として外へ渡すものではないため、送信アダプター（infrastructure）に限って抑止する。
    -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP2"/>
        <Package name="~com\.example\.cargotracker\..*\.infrastructure\..*"/>
    </Match>
    <!--
      EI_EXPOSE_REP2: TOTP の確かめのサービス（Bolt 31）が DI で受け取ったリポジトリを保持することへの指摘。上と同じく Spring が管理する
      シングルトンで、値として外へ渡さない。ほかのアプリケーションサービスは同じ形でも指摘されず、このクラスだけが指摘されたので、
      アプリケーション層の全体ではなくこのクラスに限って抑止する。
    -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP2"/>
        <Or>
            <Class name="com.example.cargotracker.identity.application.internal.commandservices.TotpVerificationService"/>
            <!-- Bolt 31b の登録のサービスと問い合わせのサービスも、同じく DI の部品を保持するだけ -->
            <Class name="com.example.cargotracker.identity.application.internal.commandservices.TotpEnrollmentService"/>
            <Class name="com.example.cargotracker.identity.application.internal.queryservices.TotpEnrollmentQueryService"/>
            <!-- Bolt 31c の回復コードの確かめのサービスも、同じく DI の部品を保持するだけ -->
            <Class name="com.example.cargotracker.identity.application.internal.commandservices.RecoveryCodeVerificationService"/>
            <!-- Bolt 32 のログインの試行のサービスも、同じく DI の部品を保持するだけ -->
            <Class name="com.example.cargotracker.identity.application.internal.commandservices.LoginAttemptService"/>
            <!-- Bolt 32c の session の確かめのサービスも、同じく DI の部品を保持するだけ -->
            <Class name="com.example.cargotracker.identity.application.internal.commandservices.SessionRevalidationService"/>
            <!-- Bolt 33 の再設定の依頼・発行とメールの送信のサービスも、同じく DI の部品を保持するだけ -->
            <Class name="com.example.cargotracker.identity.application.internal.commandservices.PasswordResetRequestService"/>
            <!-- Bolt 33a の再設定のサービスも、同じく DI の部品を保持するだけ -->
            <Class name="com.example.cargotracker.identity.application.internal.commandservices.PasswordResetCompletionService"/>
            <!-- Bolt 33b の認証アプリの再登録のサービスも、同じく DI の部品を保持するだけ -->
            <Class name="com.example.cargotracker.identity.application.internal.commandservices.TotpReEnrollmentService"/>
            <!-- A-08 の画面も、同じく DI の部品（再登録のサービス）を保持するだけ（Bolt 33b） -->
            <Class name="com.example.cargotracker.identity.interfaces.web.TotpReEnrollmentController"/>
            <!-- Bolt 34 の役割の変更のサービスと利用者の管理の照会のサービスも、同じく DI の部品を保持するだけ -->
            <Class name="com.example.cargotracker.identity.application.internal.commandservices.UserRoleChangeService"/>
            <Class name="com.example.cargotracker.identity.application.internal.queryservices.UserAdministrationQueryService"/>
            <!-- Bolt 34b の範囲外の試行の記録のサービスも、同じく DI の部品を保持するだけ -->
            <Class name="com.example.cargotracker.identity.application.internal.commandservices.AdministrationScopeDenialService"/>
            <Class name="com.example.cargotracker.identity.application.internal.eventhandlers.PasswordResetMailEventHandler"/>
            <Class name="com.example.cargotracker.notification.application.internal.commandservices.PasswordResetMailService"/>
        </Or>
    </Match>
    <!--
      SE_TRANSIENT_FIELD_NOT_RESTORED: 認証の結果のトークンの 2 つ目の要素の経路（Bolt 33e）は、意図して transient にしている。
      session（Spring Session JDBC）に経路を保存せず、直列化の形を変えないことで、ローリング配備の間に古い版が新しい版の session を
      読めるようにする（2026-10-16、Bolt 33e の開始準備の決定 4、human:kakimomokuri）。経路を読むのは同じ request の中の成功の扱い
      だけで、session から読み直したトークンの経路は null でよい。このクラスのこの欄に限って抑止する。
    -->
    <Match>
        <Bug pattern="SE_TRANSIENT_FIELD_NOT_RESTORED"/>
        <Class name="com.example.cargotracker.identity.infrastructure.security.TotpAuthenticationToken"/>
        <Field name="path"/>
    </Match>
</FindBugsFilter>
