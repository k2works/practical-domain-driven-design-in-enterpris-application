<?xml version="1.0" encoding="UTF-8"?>
<!--
  SpotBugs で抑止する指摘と、その理由。抑止は最小にし、理由のないものは足さない。
-->
<FindBugsFilter>
    <!--
      EI_EXPOSE_REP2: DI で受け取った部品（MyBatis のマッパーなど）を保持することへの指摘。
      部品は Spring が管理するシングルトンで、値として外へ渡すものではないため、送信アダプター（infrastructure）に限って抑止する。
    -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP2"/>
        <Package name="~com\.example\.cargotracker\..*\.infrastructure\..*"/>
    </Match>
    <!--
      EI_EXPOSE_REP2: identity のアプリケーションのサービス（commandservices・queryservices・eventhandlers・outboundservices の ACL）が
      DI で受け取ったリポジトリなどの部品を保持することへの指摘。上と同じく Spring が管理するシングルトンで、値として外へ渡さない。
      Bolt 31 から 34d まではクラスを 1 つずつ足して抑止していたが、identity の application.internal はどれも DI の部品を保持するだけの
      サービスの集まりなので、パッケージで指定する（Bolt 34c の開始準備の決定 3、2026-10-17、human:kakimomokuri）。
      同じパッケージの結果の record（EnrollmentResult など）も対象に入る。record は compact constructor で防御の複製をとる規約で守る
      （Bolt 34c の開発レビュー）。
    -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP2"/>
        <Package name="~com\.example\.cargotracker\.identity\.application\.internal\..*"/>
    </Match>
    <!--
      EI_EXPOSE_REP2: notification のアプリケーションのサービス（メールの送信のサービスと共有の部品）も、DI で受け取った部品を保持するだけ。
      Bolt 33 は再設定のサービスのクラスで抑止していたが、Bolt 38b2b で招待のサービスと共有の部品が加わったので、identity と同じくパッケージで
      指定する（Bolt 38b2b）。
    -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP2"/>
        <Package name="~com\.example\.cargotracker\.notification\.application\.internal\..*"/>
    </Match>
    <!--
      EI_EXPOSE_REP2: application.internal の外で、同じく DI の部品を保持するだけと分かっているクラス。このクラスに限って抑止する。
    -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP2"/>
        <Or>
            <!-- A-08 の画面は、DI の部品（再登録のサービス）を保持するだけ（Bolt 33b） -->
            <Class name="com.example.cargotracker.identity.interfaces.web.TotpReEnrollmentController"/>
            <!-- A-05・A-06 の画面は、DI の部品（依頼と完了のサービス）を保持するだけ。Bolt 38b4 で完了のサービスに初回の判定を足して指摘された -->
            <Class name="com.example.cargotracker.identity.interfaces.web.PasswordResetController"/>
        </Or>
    </Match>
    <!--
      SE_TRANSIENT_FIELD_NOT_RESTORED: 認証の結果のトークンの 2 つ目の要素の経路（Bolt 33e）は、意図して transient にしている。
      session（Spring Session JDBC）に経路を保存せず、直列化の形を変えないことで、ローリング配備の間に古い版が新しい版の session を
      読めるようにする（2026-10-16、Bolt 33e の開始準備の決定 4、human:kakimomokuri）。経路を読むのは同じ request の中の成功の扱い
      だけで、session から読み直したトークンの経路は null でよい。このクラスのこの欄に限って抑止する。
    -->
    <Match>
        <Bug pattern="SE_TRANSIENT_FIELD_NOT_RESTORED"/>
        <Class name="com.example.cargotracker.identity.infrastructure.security.TotpAuthenticationToken"/>
        <Field name="path"/>
    </Match>
    <!--
      SE_TRANSIENT_FIELD_NOT_RESTORED: 認証の主体の担当企業（Bolt 38f）は、意図して transient にしている。確かめのフィルターが request
      ごとに今の担当企業で主体を作り直すので保存しない。直列化の形を変えないので古い session もそのまま戻る（ADR-012 の改訂。2026-10-28、
      Bolt 38f の開始準備の決定 (2)、human:kakimomokuri）。戻した直後の null は actor() が空として渡す（失敗に倒す）。このクラスのこの欄に
      限って抑止する。
    -->
    <Match>
        <Bug pattern="SE_TRANSIENT_FIELD_NOT_RESTORED"/>
        <Class name="com.example.cargotracker.identity.infrastructure.security.CargoUserDetails"/>
        <Field name="assignedCompanyIds"/>
    </Match>
    <!--
      EI_EXPOSE_REP・EI_EXPOSE_REP2: 社内の側の輸送要求の引き当ての結果（Bolt 38f）は、見つかった集約をそのまま呼び手に渡すための入れ物。
      前は Optional で同じ集約を渡しており、集約を複製すると呼び手のコマンドが更新する対象が変わる。このクラスに限って抑止する。
    -->
    <Match>
        <Or>
            <Bug pattern="EI_EXPOSE_REP"/>
            <Bug pattern="EI_EXPOSE_REP2"/>
        </Or>
        <Class name="com.example.cargotracker.quotation.application.internal.queryservices.StaffTransportRequestLookup$Found"/>
    </Match>
    <!--
      EI_EXPOSE_REP・EI_EXPOSE_REP2: 経路設計の案件の引き当ての結果（Bolt 38g）も、上の輸送要求と同じく見つかった集約をそのまま呼び手に
      渡すための入れ物。集約を複製すると呼び手のコマンドが更新する対象が変わる。このクラスに限って抑止する。
    -->
    <Match>
        <Or>
            <Bug pattern="EI_EXPOSE_REP"/>
            <Bug pattern="EI_EXPOSE_REP2"/>
        </Or>
        <Class name="com.example.cargotracker.routing.application.internal.queryservices.RoutingCaseLookup$Found"/>
    </Match>
</FindBugsFilter>
